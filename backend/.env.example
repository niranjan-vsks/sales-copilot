# ── Database ───────────────────────────────────────────────────────────────
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net
DB_NAME=sales_copilot

# ── Microsoft Entra ID / D365 ─────────────────────────────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
D365_ORG_URL=https://your-org.crm.dynamics.com

# ── AI (Groq / Llama) ──────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Secrets (generate your own — never reuse the examples) ───────────────
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
PAYLOAD_ENCRYPTION_KEY=
INTERNAL_KEY=

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
